# .streamlit/secrets.toml
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .streamlit/secrets.toml and fill in your values.
# NEVER commit the real secrets.toml to GitHub — it is in .gitignore.
#
# On Streamlit Cloud: paste these values in
#   App Settings → Secrets  (no file needed)
# ─────────────────────────────────────────────────────────────────────────────

TMDB_API_KEY = "your_tmdb_api_key_here"
